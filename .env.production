# Public Supabase settings used for production builds (GitHub Pages).
# Both values are designed to be public: data is protected by sign-in and the
# row-level security rules in supabase/schema.sql. Never put the secret key here.
VITE_SUPABASE_URL=https://fayvgmaxpqjxgjvbpmgz.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ZcYjQJWiLLXRJ1eYmqO4ww_Z0BID55m

# Google Maps (map, place search, ratings/hours). Leave empty to use OpenStreetMap instead.
# This key ships in the site, so restrict it to your site's address in Google Cloud (see README).
VITE_GOOGLE_MAPS_API_KEY=
# Optional: your own Map ID (Google Cloud → Map Management). Google's demo ID is used otherwise.
VITE_GOOGLE_MAP_ID=
