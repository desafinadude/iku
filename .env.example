# Leave these empty to run in local mode (data kept in this browser only).
# VITE_* or NEXT_PUBLIC_* names both work.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional. Set it and the unlock screen asks only for the password, but the email
# is then readable in the published site. Leave empty to ask for email + password.
VITE_TRIP_EMAIL=
